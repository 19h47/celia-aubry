{#
 # Image
 #
 # @param array classes
 # @param string loading
 # @param array image
 # @param object attributes
 # @param string size
 #
 # @package WordPress
 # @subpackage CeliaAubry
 #}

{% if image %}
	{% set image = get_image( image ) %}
	{% set size = 'image/gif' == image.post_mime_type ? 'full' : size | default( 'large' ) %}

	<picture class="block"{{ size ? " data-size=\"#{ size }\"" : '' }} data-mime-type="{{ image.post_mime_type }}">

		{%- if 'image/svg+xml' != image.post_mime_type and 'image/gif' != image.post_mime_type -%}
			{%- if image.srcset -%}
				<source type="image/webp" srcset="{{
					image.srcset
						| split( ', ' )
						| map( url => url
							| split( ' ' )
							| map( ( part, i ) => i == 0 ? part | towebp( 82 ) : part )
							| join( ' ' )
						)
						| join( ', ' )
				}}" sizes="{{ image.img_sizes( size ) }}">
			{%- else -%}
				{#- A size with no same-ratio sibling has no srcset: still offer its WebP. -#}
				<source type="image/webp" srcset="{{ image.src( size ) | towebp( 82 ) }}">
			{%- endif -%}
		{%- endif -%}

		<img
			class="{{ html_classes( '', classes | default( [] ) | join( ' ' ) ) }}"
			loading="{{ loading | default( 'lazy' ) }}"
			src="{{ image.src( size ) }}"
			alt="{{ image.alt }}"
			width="{{ image.width }}"
			height="{{ image.height }}"
			{{ image.srcset ? "srcset=\"#{ image.srcset }\"" : '' }}
			{{ image.img_sizes ? "sizes=\"#{ image.img_sizes( size ) }\"" : '' }}
			{{ attributes ? attributes | map( ( value, key ) => "#{key}=\"#{value}\"" ) | join( ' ' ) | raw }}
			data-module-image
		>

	</picture>
{% endif %}


